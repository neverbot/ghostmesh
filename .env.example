# WebSocket-to-TCP proxy (for IRC servers without native WebSocket)
VITE_PROXY_URL=ws://localhost:8080
VITE_PROXY_SECRET=change-me-in-production

# Optional default IRC identity (leave unset to ship empty inputs).
# When empty, the user's nickname is used as the final fallback at connect time.
# VITE_DEFAULT_USERNAME=
# VITE_DEFAULT_REALNAME=
