# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.vite
dist
dist-ssr
*.local
.env*
!.env.example

# Plugin files are provided by an overlay (see src/plugins/README.md). Only
# the scaffolding (.gitkeep, README) is tracked — never commit concrete plugin
# files into this repo.
src/plugins/*/*.ts
src/plugins/*/*.js
!src/plugins/*/.gitkeep
!src/plugins/*/README.md

# TypeScript build artifacts
*.tsbuildinfo
*.d.ts
!src/env.d.ts

